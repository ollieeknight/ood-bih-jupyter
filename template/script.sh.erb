#!/usr/bin/env bash

set -x

<% if context.python_provider == "pixi" && !context.pixi_path.to_s.empty? %>
  PIXI_PATH="<%= context.pixi_path.to_s.gsub('~', '${HOME}') %>"
  export PATH="${PIXI_PATH}/.pixi/envs/default/bin:$PATH"
  jupyter <%= context.jupyter_kind %> --config="${CONFIG_FILE}"
<% else %>
  source <%= context.conda_path.split(":")[0] %>/activate
  <% if context.conda_path.include? ":" %>
    conda activate <%= context.conda_path.split(":")[1] %>
  <% end %>
  jupyter <%= context.jupyter_kind %> --config="${CONFIG_FILE}"
<% end %>

